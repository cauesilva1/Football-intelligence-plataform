# ============================================================
# Football Intelligence Platform — Environment Variables
# ============================================================

# Data source mode:
#   mock — in-memory generators (default in this example; safe for Vercel without DB)
#   db   — Prisma + Postgres (required for real multi-sport inventory / intelligence demos)
#
# DEMO RULE: if you pitch coverage counts or EuroLeague honesty, set DATA_SOURCE=db.
# See docs/DEMO-DATA-SOURCE.md
DATA_SOURCE=mock
# DATA_SOURCE=db

# Optional: force in-memory storage locally (same as Vercel behavior)
# STORAGE_MODE=memory

# ── Postgres / Supabase (required when DATA_SOURCE=db) ─────
# DATABASE_URL: Supabase transaction pooler (port 6543) — runtime on Vercel
# DIRECT_URL: Supabase session pooler (port 5432) — migrations / Prisma CLI
#
# Required query params:
#   DATABASE_URL → pgbouncer=true, schema=public
#   Local Next.js: connection_limit=5 (Suspense dispara várias queries em paralelo)
#   Vercel serverless: connection_limit=1 é ok; se aparecer P2024, use 3
#   DIRECT_URL   → schema=public
#
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&schema=public"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?schema=public"

# Lock down Supabase PostgREST (RLS on all public tables — anon cannot R/W):
#   npm run db:secure-rls
# See prisma/sql/enable-rls-lockdown.sql

# ── Supabase (optional, Sprint 4+) ────────────────────────
# Do NOT use the anon key for server Prisma. Keep anon key out of DATA_SOURCE=db paths
# until auth + explicit RLS policies exist.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── OpenRouter (AI scout reports) ─────────────────────────
OPENROUTER_API_KEY=
# Free model IDs rotate. Default in code is qwen/qwen3.8-27b:free.
# OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Optional: set to 1 to disable AI report generation (server action)
# REPORTS_DISABLED=1

# Optional: used as HTTP-Referer header for OpenRouter analytics
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Newsletter archive (/insights) ─────────────────────────
# Email delivery stays on Substack. This public URL powers the signup CTA.
# Leave unset to show a placeholder on the article page.
# NEXT_PUBLIC_NEWSLETTER_URL=https://your-publication.substack.com

# ── Cron (Vercel Cron / local scripts) ────────────────────
# Authorization: Bearer ${CRON_SECRET}
# CRON_SECRET=

# ── API-Football (API-Sports) ─────────────────────────────
# Player and club enrichment — 100 req/day on free tier
# Player enrichment: `/players` media queries always use season=2024 (API-Sports free tier cap).
# /api/cron/soccer spends this quota on defensive enrichment only (ESPN stays the free spine):
# leagues in season first, the rest on a daily rotation, never past the daily limit.
APISPORTS_KEY=

# ── API-Basketball (API-Sports) ───────────────────────────
# Separate account quota from API-Football: 100 req/day per sport.
# Used by /api/cron/basketball ONLY when the official EuroLeague API is down (≤ 1 call/day checked).
# Crons skip paid calls (with a log line) once fewer than 10 calls remain, and report
# `apiSportsQuota` (calls / used / remaining) in their JSON response. Never commit key values.
APISPORTS_BASKETBALL_KEY=

# ── Vercel deploy (db mode) ─────────────────────────────────
# DATA_SOURCE=db
# DATABASE_URL=<pooler :6543 with ?pgbouncer=true&connection_limit=1&pool_timeout=20&schema=public>
# DIRECT_URL=<session pooler :5432 with ?schema=public>
#
# Vercel deploy (mock mode — no database):
# DATA_SOURCE=mock
